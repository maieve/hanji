{
  "name": "hanji",
  "version": "0.1.0",
  "private": true,
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:cloud-merge && npm run test:document-search && npm run test:page-insert && npm run test:backup-policy && npm run test:folders && npm run test:notebook-privacy",
    "test:cloud-merge": "node --no-warnings --experimental-strip-types scripts/verifyCloudMerge.mts",
    "test:document-search": "node --no-warnings --experimental-strip-types scripts/verifyDocumentSearch.mts",
    "test:page-insert": "node --no-warnings --experimental-strip-types scripts/verifyPageInsert.mts",
    "test:backup-policy": "node --no-warnings --experimental-strip-types scripts/verifyBackupPolicy.mts",
    "test:folders": "node --no-warnings --experimental-strip-types scripts/verifyFolders.mts",
    "test:notebook-privacy": "node --no-warnings --experimental-strip-types scripts/verifyNotebookPrivacy.mts",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.11",
    "expo-asset": "~57.0.9",
    "expo-audio": "~57.0.3",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.2",
    "expo-font": "~57.0.1",
    "expo-local-authentication": "~57.0.2",
    "expo-print": "~57.0.1",
    "expo-sharing": "~57.0.10",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.0",
    "hanji-canvas": "file:modules/hanji-canvas",
    "jszip": "^3.10.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-draggable-grid": "^2.2.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.1",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3"
  }
}
